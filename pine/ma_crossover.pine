//@version=5
strategy("EMA Crossover with Fixed Stop (Research Sample)", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.1, slippage=0, process_orders_on_close=false)

fastLength = input.int(20, "Fast EMA", minval=1)
slowLength = input.int(50, "Slow EMA", minval=2)
stopPercent = input.float(5.0, "Stop loss (%)", minval=0.1, step=0.1) / 100.0

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
longSignal = ta.crossover(fastEma, slowEma)
exitSignal = ta.crossunder(fastEma, slowEma)

if longSignal
    strategy.entry("Long", strategy.long)
if exitSignal
    strategy.close("Long")

if strategy.position_size > 0
    strategy.exit("Stop", "Long", stop=strategy.position_avg_price * (1 - stopPercent))

plot(fastEma, "Fast EMA", color=color.orange)
plot(slowEma, "Slow EMA", color=color.blue)
